<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.rkrish.rkpizzakiosk.gui.dashboard.CustomerDetails">

    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <Label fx:id="productDetailsHeader"
           styleClass="top-header"
           text="CustomerDetails"/>

    <Label fx:id="customerNameLabel"
           text="Name:"/>
    <TextField fx:id="customerNameText"
               promptText="Enter Your Name "/>

    <Label fx:id="customerNumberLabel"
           text="Number:"/>
    <TextField fx:id="customerNumberText"
               promptText="Enter Your Number "/>

    <HBox styleClass="actionControls">
        <Button fx:id="cancelCustomerDetails"
                text="Cancel"
        onAction="#cancelClicked"/>

        <Button fx:id="updateProduct"
                text="Next"
        onAction="#onContinueClicked"/>
    </HBox>


</VBox>
